# Placeholder configuration for the experimental chat prototype (docs/chat-prototype.md).
# Copy to .env (gitignored), fill in, then load into the server's shell:
#   set -a; . ./.env; set +a
# Never commit a real key, and never put it in browser code, logs, fixtures, or PR text.

# Opt in to paid model calls. Leave as "none" to run without any model (sources only).
BIOTECH_RAG_CHAT_PROVIDER=none

# Server-side OpenAI credential. Prefer your environment's secret mechanism over this file.
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# BIOTECH_RAG_OPENAI_MODEL=gpt-5.5
# BIOTECH_RAG_OPENAI_REASONING_EFFORT=low
# BIOTECH_RAG_OPENAI_MAX_OUTPUT_TOKENS=3000
# BIOTECH_RAG_OPENAI_TIMEOUT_S=60
# BIOTECH_RAG_OPENAI_MAX_RETRIES=1
# BIOTECH_RAG_OPENAI_MAX_REQUESTS=50
