        "authorized_start": 26,
        "authorized_end": 64
      },
      "expected": {
        "outcomes": [
          "selected"
        ],
        "text": "Café batches require QA authorization.",
        "start": 26,
        "end": 64
      }
    },
    {
      "id": "decomposed_unicode_preserved",
      "rule": "No NFC rewriting of text or offsets",
      "body": "Café batches need review.",
