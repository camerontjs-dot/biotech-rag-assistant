{
  "schema_version": 1,
  "contract": "select_authorized_span(body, quote, *, authorized_start=None, authorized_end=None)",
  "purpose": "Fresh engineering probes of the announced explicit-bounds mechanical contract; not a replay of automatic sentence selection and not a sentence/semantic correctness claim.",
  "preconditions": "The caller supplies bounds it authorizes. Linguistic correctness, completeness, provenance, and source authorization are external preconditions, not proven by selected.",
  "exposure_before_freeze": "Announced API/outcomes, known automatic-selector failures, and parent statement that a single CRLF wrap is supported. Parent mentioned atomic grouping in its paragraph regexp in the freeze notice; no new candidate source or documentation has been read.",
  "expected_semantics": "A selected output must exactly match the specified span and offsets, with no trimming/widening. All refusals must have null text/start/end. Outside-span quote refusal may be invalid_bounds or not_found because the announcement did not specify this distinction.",
  "cases": [
    {
      "id": "ordinary_authorized_span",
      "rule": "Required exact selection with explicit authority",
      "body": "QA must sign before shipment.",
      "quote": "sign before",
      "kwargs": {
        "authorized_start": 0,
        "authorized_end": 29
      },
      "expected": {
        "outcomes": [
          "selected"
        ],
        "text": "QA must sign before shipment.",
        "start": 0,
        "end": 29
      }
    },
    {
      "id": "neighboring_sentences_not_widened",
      "rule": "Respect the explicit span without adding preceding or following sentences",
      "body": "Evidence remains limited. QA must sign before shipment. Retain these records.",
      "quote": "must sign",
      "kwargs": {
        "authorized_start": 26,
        "authorized_end": 55
      },
      "expected": {
        "outcomes": [
          "selected"
        ],
        "text": "QA must sign before shipment.",
        "start": 26,
        "end": 55
      }
    },
    {
      "id": "authorized_edge_whitespace_preserved",
      "rule": "No trimming or rewriting of caller-authorized bounds",
      "body": "Before.  QA must sign. \tAfter.",
      "quote": "QA must sign",
      "kwargs": {
        "authorized_start": 7,
        "authorized_end": 24
      },
      "expected": {
        "outcomes": [
          "selected"
        ],
        "text": "  QA must sign. \t",
        "start": 7,
        "end": 24
      }
    },
    {
      "id": "unicode_codepoint_offsets",
      "rule": "Preserve body-relative codepoint indices with astral, accented, and Greek characters",
