        "text": "Café batches need review.",
        "start": 0,
        "end": 26
      }
    },
    {
      "id": "single_lf_wrap",
      "rule": "A single line wrap is not a paragraph boundary",
      "body": "QA must sign\nbefore shipment.",
      "quote": "sign\nbefore",
      "kwargs": {
        "authorized_start": 0,
        "authorized_end": 29
      },
      "expected": {
        "outcomes": [
          "selected"
