{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Input-only semantic case packet v1",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorized_body": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "witness_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_span": {
            "type": "object",
            "properties": {
              "start": {
                "const": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "witness_id",
          "source_id",
          "text",
          "text_sha256",
          "source_sha256",
          "source_span"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4
    },
    "distractors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "surface": {
            "enum": [
              "QUERY",
              "HEADING",
              "METADATA"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "surface",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 3
    },
    "projection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "core_text": {
              "type": "string",
              "minLength": 1
            },
            "gap_text": {
              "type": "string"
            }
          },
          "required": [
            "core_text",
            "gap_text"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "case_id",
    "claim",
    "claim_sha256",
    "authorized_body",
    "distractors",
    "projection"
  ],
  "additionalProperties": false
}
